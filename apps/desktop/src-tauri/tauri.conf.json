{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phone Trackpad",
  "version": "0.0.0",
  "identifier": "com.wptrackpad.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Phone Trackpad", "width": 780, "height": 640, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Use your phone as a wireless trackpad",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
